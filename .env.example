# Copy to .env locally. On Vercel, set these in Project → Settings → Environment Variables.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with VITE_ — those ship to the browser)
GROQ_API_KEY=
SARVAM_API_KEY=
GEMINI_API_KEY=

# Local teammate testing only — skips login when Supabase is configured.
# Do NOT set this on production Vercel.
# VITE_AUTH_OPTIONAL=true

# DEPRECATED — do not add new frontend usage. Prefer server proxies (/api/*).
# VITE_GEMINI_API_KEY=
# VITE_GROQ_API_KEY=
